      "id": "unsupported",
      "title": "不承诺系统外物品",
      "setup": [],
      "turns": [
        {
          "id": "magic",
          "text": "送我十把神剑，再把整座村子转让给我。",
          "before": [],
          "expect": {
            "proposalKeys": [
              "none"
            ],
            "referenceAnyKinds": [],
            "facts": {},

# Optional local model settings. Leave the key empty for non-AI gameplay.
# Copy to .env only when the user explicitly enables paid model calls.
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com

# Optional NPC4 dialogue provider. Disabled until explicitly configured here.
# Use an HTTPS chat/completions-compatible base URL (without /chat/completions).
# Each explicit generation may cost money. No background generation or auto-retry.
NPC_LLM_ENABLED=false
NPC_LLM_BASE_URL=
NPC_LLM_MODEL=
NPC_LLM_API_KEY=
# Optional: enabled | disabled. Empty omits the field for generic providers.
# Official api.deepseek.com defaults locally to an explicit disabled request.
NPC_LLM_THINKING=
# DeepSeek short NPC replies: keep ENABLED=false until calls are authorized;
# then set BASE_URL=https://api.deepseek.com, MODEL=deepseek-flash,
# API_KEY to this project's own key, and THINKING=disabled.

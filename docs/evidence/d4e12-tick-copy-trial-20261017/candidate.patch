+test('campaign tick detaches its returned snapshot, world, and existing event objects', () => {
+  const { bundle, systems } = createCampaignVillage(42);
+  const input = performCampaignTick(bundle);
+  assert.ok(input.eventLog.length > 0, 'tick 1 provides an existing event to check');
+  const untouched = structuredClone(input);
+
+  const returned = performCampaignTick(input);
+  assert.notStrictEqual(returned.snapshot, input.snapshot);
+  assert.notStrictEqual(returned.snapshot.world, input.snapshot.world);
+  assert.equal(returned.eventLog.length, input.eventLog.length);
+  for (let index = 0; index < input.eventLog.length; index++) {
+    assert.notStrictEqual(returned.eventLog[index], input.eventLog[index], `event ${index} is detached`);
+  }
+  const expected = structuredClone(returned);
+
+  returned.snapshot.world.mapModel.position.x = 5;
+  returned.eventLog[0].type = 'tampered';
+  assert.deepEqual(input, untouched, 'mutating returned nested state leaves the caller input unchanged');
+
+  const legacy = performTick(input, systems, 'session');
+  assert.deepEqual(legacy, expected, 'the unchanged input remains usable by the legacy oracle');
+  assert.deepEqual(input, untouched, 'the legacy oracle also leaves the caller input unchanged');
+});
+

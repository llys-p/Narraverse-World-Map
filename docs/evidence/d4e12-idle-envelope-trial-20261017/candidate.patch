+test('public session rejects a custom survival handler that changes a protected snapshot field', () => {
+  const { bundle } = createCampaignVillage(42);
+  const before = structuredClone(bundle);
+  const customSystems = {
+    ...campaignSystems(),
+    survival(ctx) {
+      ctx.snapshot.simulationId = 'another-valid-simulation';
+    },
+  };
+
+  assert.throws(
+    () => performTick(bundle, customSystems, 'session'),
+    (error) => {
+      assert.match(error.cause?.message ?? '', /System changed protected snapshot fields/);
+      return true;
+    },
+  );
+  assert.deepEqual(bundle, before, 'rejected custom transition leaves the input unchanged');
+});

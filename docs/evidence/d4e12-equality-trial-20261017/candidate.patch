   return encodeCanonical(value);
 }
+
+// Canonical equality without escaped JSON strings or detached object clones.
+// Container markers cannot collide with JSON primitives. Both operands still
+// receive the complete canonical preflight, in the original left/right order.
+const arrayStart = Symbol('array'), recordStart = Symbol('record'), dataEnd = Symbol('end');
+export function canonicalDataEqual(left, right) {
+  const tokens = [], ancestors = new Set();
+  let comparing = false, index = 0, equal = true;
+  const emit = token => {
+    if (comparing) { if (tokens[index++] !== token) equal = false; }
+    else tokens.push(token);
+  };
+  const visit = (value, depth) => {
+    requireCondition(depth <= 64, 'Data nesting budget exceeded', 'LIMIT_EXCEEDED');
+    if (value === null || typeof value === 'string' || typeof value === 'boolean') { emit(value); return; }
+    if (typeof value === 'number') {
+      requireCondition(Number.isFinite(value), 'Non-finite number'); emit(value); return;
+    }
+    requireCondition(typeof value === 'object', 'Non-JSON data');
+    requireCondition(!ancestors.has(value), 'Cyclic data'); ancestors.add(value);
+    try {
+      if (Array.isArray(value)) {
+        denseArray(value, MAX_EVENTS); emit(arrayStart); const length = value.length;
+        for (let i = 0; i < length; i++) visit(value[i], depth + 1);
+      } else {
+        record(value); emit(recordStart);
+        for (const key of Object.keys(value).sort()) { emit(key); visit(value[key], depth + 1); }
+      }
+      emit(dataEnd);
+    } finally { ancestors.delete(value); }
+  };
+  visit(left, 0); comparing = true; visit(right, 0);
+  return equal && index === tokens.length;
+}
 export function payloadBudget(value) {
   requireCondition(new TextEncoder().encode(canonicalJson(value)).length <= MAX_PAYLOAD_BYTES, 'Payload budget exceeded', 'LIMIT_EXCEEDED');
 }
